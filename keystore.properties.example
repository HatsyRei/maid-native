# Copy to keystore.properties (git-ignored) to sign release builds with build.sh.
# Paths are resolved against the repo root; absolute paths are best, so the
# keystore lives outside the working tree. Values are read verbatim: no
# .properties escapes or line continuations.
storeFile=/home/you/.config/maid-native/maid-native-release-2.p12
storePassword=
keyAlias=maid-native-2
# PKCS12 keystores use the store password for the key as well.
keyPassword=
# Proof that the original key handed over to this one (APK Signature Scheme v3).
# Back it up with the keystores; it can be recreated from both keys with
# `apksigner rotate`.
lineageFile=/home/you/.config/maid-native/maid-native.lineage
