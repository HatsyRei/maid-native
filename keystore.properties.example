# Copy to keystore.properties (git-ignored) to sign release builds.
# storeFile is resolved against the repo root; an absolute path is best, so the
# keystore lives outside the working tree.
storeFile=/home/you/.config/maid-native/maid-native-release.p12
storePassword=
keyAlias=maid-native
# PKCS12 keystores use the store password for the key as well.
keyPassword=
