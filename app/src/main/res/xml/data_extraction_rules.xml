<?xml version="1.0" encoding="utf-8"?>
<!--
  API keys are encrypted with a Keystore key that never leaves the device, so a
  copy of the preferences file elsewhere would be undecryptable anyway. Excluding
  it outright keeps the ciphertext (and the endpoint list) off backup servers and
  out of device-to-device transfers, while conversations still migrate normally.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
